# ==========================================================================
# Evolution API - variables de entorno para el despliegue en VPS
# Copiar a .env y reemplazar los dos valores encerrados entre <<< y >>>
# ==========================================================================

# --------------------------------------------------------------------------
# SERVIDOR
# TLS lo termina Traefik, por eso SERVER_TYPE=http. SERVER_URL debe ser la
# URL publica con https: Evolution la usa para armar los links de media y
# la base del manager.
# --------------------------------------------------------------------------
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evo.tbadigitals.com
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# Zona horaria. La imagen viene con America/Sao_Paulo; la alineamos con n8n.
TZ=America/Bogota
LANGUAGE=en

# --------------------------------------------------------------------------
# AUTENTICACION
# Generar con:  openssl rand -hex 32
# Es la llave maestra de toda la API. Quien la tenga controla el WhatsApp.
# --------------------------------------------------------------------------
AUTHENTICATION_API_KEY=<<< CAMBIAR: openssl rand -hex 32 >>>
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# --------------------------------------------------------------------------
# BASE DE DATOS
# Reutiliza el contenedor postgres-bots que ya corre en la red n8n_default,
# con base y rol propios (ver README, paso 2).
# Aqui tambien se guardan las credenciales de sesion de Baileys, porque
# CACHE_REDIS_SAVE_INSTANCES esta en false: respaldar esta base = poder
# restaurar la sesion sin volver a escanear el QR.
# --------------------------------------------------------------------------
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:<<< CAMBIAR: password del rol evolution >>>@postgres-bots:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
# Historico completo apagado a proposito: en un VPS de 1 vCPU la sincronizacion
# inicial del historial satura la CPU y llena la base. Ponerlo en true solo si
# se necesita de verdad.
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=false

# --------------------------------------------------------------------------
# REDIS
# Contenedor evolution_redis, en la red privada del stack.
# SAVE_INSTANCES=false a proposito: asi la sesion de WhatsApp vive en Postgres
# y no depende de Redis. Redis queda solo como cache.
# --------------------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false

CACHE_LOCAL_ENABLED=false
CACHE_LOCAL_TTL=86400

# --------------------------------------------------------------------------
# SESION DE WHATSAPP / QR
# --------------------------------------------------------------------------
CONFIG_SESSION_PHONE_CLIENT=TBA Digitals
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true

# --------------------------------------------------------------------------
# CORS
# El manager se sirve desde el mismo dominio, no hace falta abrir a todos.
# --------------------------------------------------------------------------
CORS_ORIGIN=https://evo.tbadigitals.com
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# --------------------------------------------------------------------------
# LOGS
# Sin VERBOSE ni DARK: en 1 vCPU el ruido de log cuesta CPU y disco.
# --------------------------------------------------------------------------
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=false
LOG_BAILEYS=error

# --------------------------------------------------------------------------
# WEBHOOK GLOBAL
# Se deja apagado. El webhook hacia n8n se configura POR INSTANCIA, apuntando
# al contenedor de n8n por la red interna:
#   http://n8n:5678/webhook/<id-del-webhook>
# Asi el trafico nunca sale a internet.
# --------------------------------------------------------------------------
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,422

# --------------------------------------------------------------------------
# WEBSOCKET
# Lo usa el manager para mostrar el QR en vivo. Traefik pasa el upgrade solo.
# --------------------------------------------------------------------------
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=false
WEBSOCKET_ALLOWED_HOSTS=

# --------------------------------------------------------------------------
# COLAS DE MENSAJES - no se usan en este despliegue
# --------------------------------------------------------------------------
RABBITMQ_ENABLED=false
NATS_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false

# --------------------------------------------------------------------------
# CHATBOTS / INTEGRACIONES - apagados. La logica vive en n8n.
# --------------------------------------------------------------------------
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false

# --------------------------------------------------------------------------
# ALMACENAMIENTO
# Sin S3: la media se guarda en base64 / disco local. Con un solo numero y
# 38 GB libres alcanza de sobra. Migrar a S3/MinIO si crece el volumen.
# --------------------------------------------------------------------------
S3_ENABLED=false

# --------------------------------------------------------------------------
# OTROS
# --------------------------------------------------------------------------
PROMETHEUS_METRICS=false
TELEMETRY_ENABLED=false
EVENT_EMITTER_MAX_LISTENERS=50
PROVIDER_ENABLED=false
SENTRY_DSN=
